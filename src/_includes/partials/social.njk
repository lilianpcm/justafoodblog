{# Ícones sociais. Pinterest só aparece quando houver link em site.json (social.pinterest). Sem Instagram (decisão da Lilian). #}
{% set pin = site.social.pinterest if site.social.pinterest.slice(0, 4) == "http" else "" %}
<ul class="social">
  {% if pin %}<li><a href="{{ pin }}" rel="noopener" aria-label="Pinterest"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 3a7 7 0 0 0-2.6 13.5M11 9l-3 12M12 3a7 7 0 0 1 4 12.7c-1.5 1-3.6.5-4-1.2"/></svg></a></li>{% endif %}
  <li><a href="{{ etsy('', 'site', 'social') }}" rel="noopener" aria-label="Etsy shop" data-etsy="social"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.5 12h-11zM9 8V6a3 3 0 0 1 6 0v2"/></svg></a></li>
</ul>
